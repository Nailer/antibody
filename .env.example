# Local workstation only unless ACCESS_TOKEN is set behind HTTPS.
ACCESS_TOKEN=
ANTIBODY_DATA_DIR=.data
SEMGREP_BIN=.venv/bin/semgrep
GITLAB_URL=https://gitlab.com
GITLAB_TOKEN=
GITLAB_PROJECT_ID=
GITLAB_FLOW_CONSUMER_ID=

# Cloud Run: use Firestore with the service account's default credentials.
ANTIBODY_STORE=sqlite
GOOGLE_CLOUD_PROJECT=

# Dedicated named database; never use another application's default database.
FIRESTORE_DATABASE_ID=antibody

# Hosted PostgreSQL (Neon/Render): ANTIBODY_STORE=postgres
DATABASE_URL=

# Set configured for a project-scoped token; otherwise membership search is used.
GITLAB_PROJECT_SCOPE=
